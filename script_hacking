-- ═══════════════════════════════════════════════════════════════════════
-- RENDER FUNCTIONS (defined before use)
-- ═══════════════════════════════════════════════════════════════════════
local function clearChildren(parent)
    for _, c in ipairs(parent:GetChildren()) do
        if c:IsA("GuiObject") and not c:IsA("UIListLayout") and not c:IsA("UIPadding") then
            c:Destroy()
        end
    end
end

function renderRemotes()
    clearChildren(remScroll)
    local n = 0
    for _, r in ipairs(S.remotes) do
        local lvl, col = levelOf(r.score)
        local include = S.filterVal == "ALL"
            or (S.filterVal == "CRIT" and r.score >= 8)
            or (S.filterVal == "HIGH" and r.score >= 5)
            or (S.filterVal == "MED"  and r.score >= 3)
            or (S.filterVal == "WATCH" and S.watchlist[r.name])

        if S.searchText ~= "" then
            local q = string.lower(S.searchText)
            if not (string.find(string.lower(r.name), q, 1, true) or string.find(string.lower(r.path or ""), q, 1, true)) then
                include = false
            end
        end

        if include then
            n = n + 1
            if n > 150 then break end

            local row = Instance.new("Frame", remScroll)
            row.Size = UDim2.new(1, -4, 0, 0)
            row.AutomaticSize = Enum.AutomaticSize.Y
            row.BackgroundColor3 = C.Card
            row.BorderSizePixel = 0
            row.BackgroundTransparency = 0.35
            corner(row, 5); pad(row, 5, 5, 5, 5)

            local topRow = Instance.new("Frame", row)
            topRow.Size = UDim2.new(1, 0, 0, 18); topRow.BackgroundTransparency = 1

            local tag = Instance.new("TextLabel", topRow)
            tag.Size = UDim2.new(0, 46, 1, 0); tag.Position = UDim2.new(0, 0, 0, 0)
            tag.BackgroundColor3 = col; tag.BorderSizePixel = 0
            tag.Text = lvl; tag.TextColor3 = C.Bg
            tag.Font = C.FB; tag.TextSize = 8; corner(tag, 3)

            local nm = Instance.new("TextLabel", topRow)
            nm.Size = UDim2.new(1, -120, 1, 0); nm.Position = UDim2.new(0, 50, 0, 0)
            nm.BackgroundTransparency = 1
            nm.Text = r.name
            nm.TextColor3 = C.Text; nm.Font = C.FB; nm.TextSize = 9
            nm.TextXAlignment = Enum.TextXAlignment.Left
            nm.TextTruncate = Enum.TextTruncate.AtEnd

            local watch = Instance.new("TextButton", topRow)
            watch.Size = UDim2.new(0, 20, 1, 0); watch.Position = UDim2.new(1, -42, 0, 0)
            watch.BackgroundColor3 = C.Card; watch.BorderSizePixel = 0
            watch.Text = S.watchlist[r.name] and "★" or "☆"
            watch.TextColor3 = S.watchlist[r.name] and C.Pink or C.Dim
            watch.Font = C.FB; watch.TextSize = 11
            corner(watch, 3)
            watch.MouseButton1Click:Connect(function()
                if S.watchlist[r.name] then
                    S.watchlist[r.name] = nil
                    watch.Text = "☆"; watch.TextColor3 = C.Dim
                else
                    S.watchlist[r.name] = r
                    watch.Text = "★"; watch.TextColor3 = C.Pink
                end
                renderWatchlist()
            end)

            local copy = Instance.new("TextButton", topRow)
            copy.Size = UDim2.new(0, 20, 1, 0); copy.Position = UDim2.new(1, -20, 0, 0)
            copy.BackgroundColor3 = C.Card; copy.BorderSizePixel = 0
            copy.Text = "📋"; copy.TextColor3 = C.Green
            copy.Font = C.FB; copy.TextSize = 10
            corner(copy, 3)
            copy.MouseButton1Click:Connect(function()
                local txt = "[" .. lvl .. "] " .. r.name .. " (" .. r.class .. ")\nPath: " .. (r.path or "") .. "\nScore: " .. tostring(r.score)
                if setclipboard then pcall(setclipboard, txt) end
                notify("Copy", r.name:sub(1, 18), C.Green)
            end)

            -- select on row click
            local rowBtn = Instance.new("TextButton", row)
            rowBtn.Size = UDim2.new(1, 0, 0, 18); rowBtn.Position = UDim2.new(0, 0, 0, 0)
            rowBtn.BackgroundTransparency = 1; rowBtn.Text = ""
            rowBtn.MouseButton1Click:Connect(function()
                S.selectedRemote = r
                execTarget.Text = "🎯 " .. r.name .. "\n" .. (r.path or "")
                notify("Selected", r.name:sub(1, 20), C.Cyan)
            end)

            local pth = Instance.new("TextLabel", row)
            pth.Size = UDim2.new(1, 0, 0, 0); pth.AutomaticSize = Enum.AutomaticSize.Y
            pth.BackgroundTransparency = 1
            pth.Text = r.path or ""; pth.TextColor3 = C.Dim
            pth.Font = C.Mono; pth.TextSize = 8
            pth.TextXAlignment = Enum.TextXAlignment.Left
            pth.TextWrapped = true

            local meta = Instance.new("TextLabel", row)
            meta.Size = UDim2.new(1, 0, 0, 0); meta.AutomaticSize = Enum.AutomaticSize.Y
            meta.BackgroundTransparency = 1
            local mtxt = "s=" .. string.format("%.1f", r.score)
            if r.reasons and #r.reasons > 0 then
                mtxt = mtxt .. " kw=[" .. table.concat(r.reasons, ","):sub(1, 40) .. "]"
            end
            if r.flags and #r.flags > 0 then
                mtxt = mtxt .. " f=[" .. table.concat(r.flags, ",") .. "]"
            end
            if r.firstSeen then mtxt = mtxt .. " ★NEW" end
            meta.Text = mtxt; meta.TextColor3 = col
            meta.Font = C.Mono; meta.TextSize = 8
            meta.TextXAlignment = Enum.TextXAlignment.Left
            meta.TextWrapped = true

            local rl = Instance.new("UIListLayout", row)
            rl.Padding = UDim.new(0, 2)
        end
    end
    if n == 0 then
        local em = Instance.new("TextLabel", remScroll)
        em.Size = UDim2.new(1, -4, 0, 30); em.BackgroundTransparency = 1
        em.Text = "(لا نتائج)"; em.TextColor3 = C.Muted
        em.Font = C.F; em.TextSize = 10
    end
end

function renderLive()
    clearChildren(liveScroll)
    local n = 0
    for i = #S.live, 1, -1 do
        n = n + 1
        if n > 80 then break end
        local e = S.live[i]
        local l = Instance.new("TextLabel", liveScroll)
        l.Size = UDim2.new(1, -4, 0, 0); l.AutomaticSize = Enum.AutomaticSize.Y
        l.BackgroundColor3 = C.Card; l.BackgroundTransparency = 0.5
        local argStr = ""
        if e.args and #e.args > 0 then
            local parts = {}
            for j, a in ipairs(e.args) do
                if type(a) == "Instance" then parts[j] = a.Name
