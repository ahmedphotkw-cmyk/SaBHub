-- ANALYTICS ENGINE
-- ═══════════════════════════════════════════════════════════════════════
local function updateAnalytics()
    local dist = {CRIT = 0, HIGH = 0, MED = 0, LOW = 0, NONE = 0}
    local kws = {}
    local srcs = {}

    for _, r in ipairs(S.remotes) do
        local lvl = levelOf(r.score)
        dist[lvl] = (dist[lvl] or 0) + 1
        for _, kw in ipairs(r.reasons or {}) do
            kws[kw] = (kws[kw] or 0) + 1
        end
        local s = r.source or "?"
        srcs[s] = (srcs[s] or 0) + 1
    end

    -- chart
    local total = #S.remotes
    if total == 0 then total = 1 end
    local order = {{"CRIT", C.Red}, {"HIGH", C.Orange}, {"MED", C.Yellow}, {"LOW", C.Dim}, {"NONE", C.Muted}}
    local cum = 0
    for i, o in ipairs(order) do
        local cnt = dist[o[1]] or 0
        local pct = cnt / total
        local seg = chartSegments[i]
        seg.Position = UDim2.new(cum, 0, 0, 0)
        seg.Size = UDim2.new(pct, 0, 1, 0)
        cum = cum + pct
    end

    chartLbl.Text = string.format(
        "CRIT: %d  HIGH: %d  MED: %d  LOW: %d  NONE: %d\nTotal: %d remotes",
        dist.CRIT, dist.HIGH, dist.MED, dist.LOW, dist.NONE, #S.remotes
    )

    -- top keywords
    local kwArr = {}
    for k, v in pairs(kws) do table.insert(kwArr, {k=k, v=v}) end
    table.sort(kwArr, function(a, b) return a.v > b.v end)
    local kwLines = {}
    for i, k in ipairs(kwArr) do
        if i > 12 then break end
        table.insert(kwLines, string.format("%-14s %d", k.k, k.v))
    end
    kwLbl.Text = #kwLines > 0 and table.concat(kwLines, "\n") or "لا توجد keywords"

    -- sources
    local srcArr = {}
    for k, v in pairs(srcs) do table.insert(srcArr, {k=k, v=v}) end
    table.sort(srcArr, function(a, b) return a.v > b.v end)
    local srcLines = {}
    for i, s in ipairs(srcArr) do
        if i > 8 then break end
        table.insert(srcLines, string.format("%-16s %d", s.k, s.v))
    end
    srcLbl.Text = #srcLines > 0 and table.concat(srcLines, "\n") or "لا توجد بيانات"
end

