-- MAIN SCAN
-- ═══════════════════════════════════════════════════════════════════════
local function addScript(name, class, path)
    for _, s in ipairs(S.scripts) do
        if s.path == path then return end
    end
    table.insert(S.scripts, {name = name, class = class, path = path})
end

function scanCoroutine(quick)
    if S.scanning then return end
    S.scanning = true
    S.remotes = {}
    S.scripts = {}
    setStatus("SCANNING", C.Yellow)

    local t0 = tick()

    -- Layer 1: game.Descendants (chunked)
    setProgress(0.05, "Layer 1: game.Descendants")
    local children = game:GetDescendants()
    local total = #children
    local chunk = 0
    for i = 1, total do
        if not S.scanning then break end
        local obj = children[i]
        if obj then
            local cls = obj.ClassName
            if cls == "RemoteEvent" or cls == "RemoteFunction" or cls == "UnreliableRemoteEvent" then
                addRemote(obj.Name, cls, obj:GetFullName(), "game", 0)
            elseif cls == "Script" or cls == "LocalScript" or cls == "ModuleScript" then
                addScript(obj.Name, cls, obj:GetFullName())
            end
        end
        chunk = chunk + 1
        if chunk >= 400 then
            chunk = 0
            setProgress(0.05 + 0.30 * (i/total), "Layer 1: " .. i .. "/" .. total)
            Run.RenderStepped:Wait()
        end
    end

    if quick then
        setProgress(1, "Done")
        S.lastScan = tick()
        S.scanning = false
        setStatus("READY", C.Green)
        refreshStats()
        renderRemotes()
        renderScripts()
        updateAnalytics()
        local sus = 0
        for _, r in ipairs(S.remotes) do if r.score >= 3 then sus = sus + 1 end end
        notify("Quick Scan", string.format("%d remotes · %d مشبوه · %.2fs", #S.remotes, sus, tick()-t0), C.Green)
        return
    end

    Run.RenderStepped:Wait()

    -- Layer 2: getnilinstances
    if S.settings.scanNil then
        setProgress(0.40, "Layer 2: getnilinstances")
        if getnilinstances then
            pcall(function()
                local list = getnilinstances()
                if type(list) == "table" then
                    for _, obj in ipairs(list) do
                        if obj and (obj.ClassName == "RemoteEvent" or obj.ClassName == "RemoteFunction") then
                            addRemote(obj.Name, obj.ClassName, "(nil instance)", "nil", 3)
                        end
                    end
                end
            end)
        end
        Run.RenderStepped:Wait()
    end

    -- Layer 3: Workspace
    if S.settings.scanWS then
        setProgress(0.50, "Layer 3: Workspace")
        pcall(function()
            for _, obj in ipairs(WS:GetDescendants()) do
                if obj.ClassName == "RemoteEvent" or obj.ClassName == "RemoteFunction" then
                    addRemote(obj.Name, obj.ClassName, obj:GetFullName(), "Workspace", 1)
                end
            end
        end)
        Run.RenderStepped:Wait()
    end

    -- Layer 4: PlayerGui
    if S.settings.scanPlayer then
        setProgress(0.58, "Layer 4: PlayerGui")
        pcall(function()
            for _, obj in ipairs(LP:GetDescendants()) do
                if obj.ClassName == "RemoteEvent" or obj.ClassName == "RemoteFunction" then
                    addRemote(obj.Name, obj.ClassName, obj:GetFullName(), "PlayerGui", 1)
                end
            end
        end)
        Run.RenderStepped:Wait()
    end

    -- Layer 5: getloadedmodules
    if S.settings.scanModules then
        setProgress(0.66, "Layer 5: Loaded modules")
        if getloadedmodules then
            pcall(function()
                local mods = getloadedmodules()
                if type(mods) == "table" then
                    for _, m in ipairs(mods) do
                        pcall(function()
                            addScript(m.Name or "?", "Module", (m.GetFullName and m:GetFullName()) or "?")
                        end)
                    end
                end
            end)
        end
        Run.RenderStepped:Wait()
    end

    -- Layer 6: getreg
    if S.settings.scanReg then
        setProgress(0.74, "Layer 6: Registry")
        if getreg then
            pcall(function()
                local reg = getreg()
                local count = 0
                for _, v in pairs(reg) do
                    if count > 300 then break end
                    count = count + 1
                    if type(v) == "userdata" then
                        pcall(function()
                            local mt = getmetatable(v)
                            if mt and mt.__name == "RemoteEvent" then
                                addRemote("reg_entry_" .. count, "RemoteEvent", "(registry)", "getreg", 4)
                            end
                        end)
                    end
                end
            end)
        end
    end

    -- Layer 7: getgc scan (للـ functions المتروكة)
    setProgress(0.80, "Layer 7: getgc analysis")
    if getgc then
        pcall(function()
            local gc = getgc(true)
            if type(gc) == "table" then
                local fnCount = 0
                for _, v in ipairs(gc) do
                    if type(v) == "function" then
                        fnCount = fnCount + 1
                    end
                end
                -- سجل فقط العدد (لأداء)
            end
        end)
    end

    -- Layer 8: Sound/Animation leaks
    if S.settings.scanSound then
        setProgress(0.85, "Layer 8: Sound scan")
        pcall(function()
            for _, s in ipairs(Sound:GetDescendants()) do
                if s:IsA("Sound") and s.Name ~= "" then
                    -- تجاهل الأصوات العادية
                end
            end
        end)
    end

    -- Hook installation (مرة واحدة)
    if not S.hooksInstalled then
        pcall(function()
            if hookmetamethod and getnamecallmethod and newcclosure then
                local old
                old = hookmetamethod(game, "__namecall", newcclosure(function(self, ...)
                    local m = getnamecallmethod()
                    if m == "FireServer" or m == "InvokeServer" then
                        if typeof(self) == "Instance" and (self.ClassName == "RemoteEvent" or self.ClassName == "RemoteFunction") then
                            local fullName = self:GetFullName()
                            table.insert(S.live, {
                                time = os.date("%H:%M:%S"),
                                name = fullName,
                                method = m,
                                args = {...},
                            })
                            if #S.live > 250 then table.remove(S.live, 1) end

                            -- Watchlist alert
                            if S.settings.watchAlerts then
                                for wname, _ in pairs(S.watchlist) do
                                    if self.Name == wname or fullName:find(wname, 1, true) then
                                        notify("★ WATCH ALERT", wname .. " fired!", C.Pink)
                                    end
                                end
                            end
                        end
                    end
                    return old(self, ...)
                end))
                S.hooksInstalled = true
            end
        end)
    end

    -- Sort
    table.sort(S.remotes, function(a, b) return a.score > b.score end)

    setProgress(1, "Done in " .. string.format("%.2fs", tick() - t0))
    S.lastScan = tick()
    S.scanning = false
    setStatus("READY", C.Green)

    refreshStats()
    renderRemotes()
    renderScripts()
    updateAnalytics()

    local susCount = 0
    for _, r in ipairs(S.remotes) do if r.score >= 3 then susCount = susCount + 1 end end
    notify("Scan Complete", string.format("%d remotes · %d مشبوه · %.2fs", #S.remotes, susCount, tick()-t0), C.Green)
end

