    table.insert(L, "  Live Events:      " .. #S.live)
    table.insert(L, "  Watchlisted:      " .. (function() local n=0 for _ in pairs(S.watchlist) do n=n+1 end return n end)())
    table.insert(L, "")
    table.insert(L, "◆ SUSPICIOUS REMOTES (score ≥ 3)")
    table.insert(L, "─────────────────────────────────────────────────────────")
    for _, r in ipairs(S.remotes) do
        if r.score >= 3 then
            local lvl = levelOf(r.score)
            table.insert(L, string.format("[%s] %s", lvl, r.name))
            table.insert(L, "  Class:    " .. r.class)
            table.insert(L, "  Path:     " .. (r.path or ""))
            table.insert(L, "  Score:    " .. string.format("%.1f", r.score))
            table.insert(L, "  Source:   " .. (r.source or "?"))
            if r.reasons and #r.reasons > 0 then
                table.insert(L, "  Keywords: " .. table.concat(r.reasons, ", "))
            end
            if r.flags and #r.flags > 0 then
                table.insert(L, "  Flags:    " .. table.concat(r.flags, ", "))
            end
            table.insert(L, "")
        end
    end
    table.insert(L, "◆ ALL REMOTES (sorted by score)")
    table.insert(L, "─────────────────────────────────────────────────────────")
    for _, r in ipairs(S.remotes) do
        table.insert(L, string.format("[%2.1f] [%s] %s  →  %s",
            r.score, r.class:gsub("Remote",""), r.name, r.path or ""))
    end
    table.insert(L, "")
    table.insert(L, "◆ SCRIPTS (" .. #S.scripts .. ")")
    table.insert(L, "─────────────────────────────────────────────────────────")
    for _, s in ipairs(S.scripts) do
        table.insert(L, "[" .. s.class .. "] " .. s.name .. "  →  " .. (s.path or ""))
    end
    table.insert(L, "")
    table.insert(L, "◆ LIVE EVENTS (last 30)")
    table.insert(L, "─────────────────────────────────────────────────────────")
    local start = math.max(1, #S.live - 30)
    for i = start, #S.live do
        local e = S.live[i]
        local argStr = ""
        if e.args and #e.args > 0 then
            local parts = {}
            for j, a in ipairs(e.args) do
                if type(a) == "Instance" then parts[j] = a.Name
                else parts[j] = tostring(a) end
            end
            argStr = "(" .. table.concat(parts, ", ") .. ")"
        end
        table.insert(L, "[" .. e.time .. "] " .. e.method .. " " .. e.name .. argStr)
    end
    table.insert(L, "")
    table.insert(L, "═══════════════════════════════════════════════════════════")
    table.insert(L, "END OF REPORT — Modark Deep Scanner v4.0")
    table.insert(L, "═══════════════════════════════════════════════════════════")

    local txt = table.concat(L, "\n")
    local copied = false
    if setclipboard then copied = pcall(setclipboard, txt) end
    if not copied and tosetclipboard then copied = pcall(tosetclipboard, txt) end
    print(txt)
    notify("Master Report", copied and ("نُسخ " .. #txt .. " حرف") or "طُبع في Console", C.Accent)
end

