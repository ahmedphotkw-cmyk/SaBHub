-- معامل الترتيب لكل فئة
local KW_WEIGHT = {
    critical = 5, high = 3, medium = 2, low = 1, network = 0.5,
}

local function scoreName(name)
    local l = string.lower(name)
    local score, reasons, matchedCats = 0, {}, {}
    for cat, groups in pairs(KW) do
        local w = KW_WEIGHT[cat]
        for _, group in ipairs(groups) do
            for _, kw in ipairs(group) do
                if string.find(l, kw, 1, true) then
                    score = score + w
                    table.insert(reasons, kw)
                    matchedCats[cat] = (matchedCats[cat] or 0) + 1
                end
            end
        end
    end
    return score, reasons, matchedCats
end

local function levelOf(sc)
    if sc >= 8 then return "CRIT", C.Red end
    if sc >= 5 then return "HIGH", C.Orange end
    if sc >= 3 then return "MED", C.Yellow end
    if sc >= 1 then return "LOW", C.Dim end
    return "NONE", C.Muted
end

-- كشف الأسماء المشبوهة (Obfuscated)
local function analyzeNamePattern(name)
    local flags = {}
    -- 1. أرقام عشوائية فقط
    if name:match("^%d+$") then table.insert(flags, "numeric_only") end
    -- 2. أرقام طويلة (hash-like)
    if name:match("%d%d%d%d%d%d%d%d") then table.insert(flags, "long_numeric") end
    -- 3. حروف عشوائية
    if name:match("^%u%l%u%l%u%l") then table.insert(flags, "random_caps") end
    -- 4. رموز غريبة
    if name:match("[^%w_%-%.]") then table.insert(flags, "special_chars") end
    -- 5. طويل جداً
    if #name > 40 then table.insert(flags, "very_long") end
    -- 6. قصير جداً (حرف واحد)
    if #name == 1 and name:match("%a") then table.insert(flags, "single_char") end
    return flags
end

-- Entropy حسابي (يعطي 0-1)
local function entropy(s)
    if #s == 0 then return 0 end
    local counts = {}
    for i = 1, #s do
        local c = s:sub(i,i)
        counts[c] = (counts[c] or 0) + 1
    end
    local e = 0
    for _, ct in pairs(counts) do
        local p = ct / #s
        e = e - p * math.log(p) / math.log(2)
    end
    return e / 8
end

