            argStr = table.concat(parts, ",")
            if #argStr > 60 then argStr = argStr:sub(1,60) .. "…" end
        end
        l.Text = "[" .. e.time .. "] " .. e.method:sub(1,6) .. " " .. e.name:sub(1,30) .. "(" .. argStr .. ")"
