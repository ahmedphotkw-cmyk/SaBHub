local function setStatus(txt, col)
    statTxt.Text = txt
    statTxt.TextColor3 = col or C.Green
    statDot.BackgroundColor3 = col or C.Green
end

local function setProgress(pct, label)
    tw(progBar, 0.15, {Size = UDim2.new(pct, 0, 1, 0)})
    progLbl.Text = label or ""
end

local function refreshStats()
    local sus = 0
    for _, r in ipairs(S.remotes) do
        if r.score >= 3 then sus = sus + 1 end
    end
    statLbl.Text = string.format(
        "Remotes: %d\nScripts: %d\nSuspicious: %d\nLive Events: %d",
        #S.remotes, #S.scripts, sus, #S.live
    )
end

local function addRemote(name, class, path, source, bonus)
    -- dedupe by path
    for _, r in ipairs(S.remotes) do
        if r.path == path and r.name == name then
            -- merge
            r.score = math.max(r.score, (r.score or 0))
            return
        end
    end

    local sc, why = scoreName(name)
    local flags = analyzeNamePattern(name)
    sc = sc + (bonus or 0)

    -- flag bonus
    if #flags > 0 then sc = sc + #flags * 0.5 end

    -- first seen
    local firstSeen = false
    if not S.firstSeen[path] then
        S.firstSeen[path] = os.time()
        firstSeen = true
    end

    -- entropy
    local ent = entropy(name)

    table.insert(S.remotes, {
        name = name, class = class, path = path,
        score = sc, reasons = why, source = source,
        flags = flags, firstSeen = firstSeen,
        entropy = ent,
        seenAt = os.time(),
    })
end

local function clearChildren(parent)
    for _, c in ipairs(parent:GetChildren()) do
        if c:IsA("GuiObject") and not c:IsA("UIListLayout") and not c:IsA("UIPadding") then
            c:Destroy()
        end
    end
end

