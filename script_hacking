-- ADD REMOTE
-- ═══════════════════════════════════════════════════════════════════════
local function addRemote(name, class, path, source, bonus)
    for _, r in ipairs(S.remotes) do
        if r.path == path and r.name == name then return end
    end
    local sc, why = scoreName(name)
    local flags = analyzeName(name)
    sc = sc + (bonus or 0)
    if #flags > 0 then sc = sc + #flags * 0.5 end
    local firstSeen = false
    if not S.firstSeen[path] then
        S.firstSeen[path] = os.time()
        firstSeen = true
    end
    table.insert(S.remotes, {
        name = name, class = class, path = path,
        score = sc, reasons = why, source = source,
        flags = flags, firstSeen = firstSeen,
        entropy = entropy(name), seenAt = os.time(),
    })
end

local function addScript(name, class, path)
    for _, s in ipairs(S.scripts) do
        if s.path == path then return end
    end
    table.insert(S.scripts, {name = name, class = class, path = path})
end

