-- EXECUTE
-- ═══════════════════════════════════════════════════════════════════════
local function findRemoteByPath(path)
    local cur = game
    for p in string.gmatch(path, "[^%.]+") do
        if not cur then return nil end
        cur = cur:FindFirstChild(p)
    end
    return cur
end

function executeRemote(noArgs)
    if not S.selectedRemote then
        notify("Execute", "اختر Remote أولاً", C.Red); return
    end
    local remote = findRemoteByPath(S.selectedRemote.path)
    if not remote then
        notify("Execute", "لم يُوجد", C.Red); return
    end

    local args = {}
    if not noArgs and argsBox.Text ~= "" then
        local txt = argsBox.Text
        local okJson, parsed = pcall(function() return HttpS:JSONDecode(txt) end)
        if okJson and type(parsed) == "table" then
            args = parsed
        else
            for token in string.gmatch(txt, "([^|]+)") do
                token = token:gsub("^%s+", ""):gsub("%s+$", "")
                local num = tonumber(token)
                if num then table.insert(args, num)
                elseif token == "true" then table.insert(args, true)
                elseif token == "false" then table.insert(args, false)
                else
                    token = token:gsub('^"(.*)"$', "%1")
                    table.insert(args, token)
                end
            end
        end
    end

    local method = curMethod
    local ok, result
    if method == "InvokeServer" then
        ok, result = pcall(function() return remote:InvokeServer(unpack(args)) end)
    else
        ok, result = pcall(function() remote:FireServer(unpack(args)) end)
        result = "(fired)"
    end

    table.insert(S.execHistory, 1, {
        time = os.date("%H:%M:%S"),
        name = S.selectedRemote.name,
        method = method,
        result = tostring(result),
        ok = ok,
    })
    if #S.execHistory > 30 then table.remove(S.execHistory) end
    renderHistory()
    notify(method, (ok and "✓ " or "✗ ") .. S.selectedRemote.name:sub(1, 18), ok and C.Green or C.Red)
end

-- ═══════════════════════════════════════════════════════════════════════
-- SCAN
-- ═══════════════════════════════════════════════════════════════════════
function scanCoroutine(quick)
    if S.scanning then return end
    S.scanning = true
    S.remotes = {}
    S.scripts = {}
    setStatus("SCANNING", C.Yellow)
    local t0 = clock()

    setProgress(0.05, "Layer 1: game.Descendants")
    local children = game:GetDescendants()
    local total = #children
    local chunk = 0
    for i = 1, total do
        if not S.scanning then break end
        local obj = children[i]
        if obj then
            local cls = obj.ClassName
            if cls == "RemoteEvent" or cls == "RemoteFunction" or cls == "UnreliableRemoteEvent" then
                addRemote(obj.Name, cls, obj:GetFullName(), "game", 0)
            elseif cls == "Script" or cls == "LocalScript" or cls == "ModuleScript" then
                addScript(obj.Name, cls, obj:GetFullName())
            end
        end
        chunk = chunk + 1
        if chunk >= 400 then
            chunk = 0
            setProgress(0.05 + 0.30 * (i/total), "L1: " .. i .. "/" .. total)
            Run.RenderStepped:Wait()
        end
    end

    if not quick and S.scanning then
        Run.RenderStepped:Wait()

        if S.settings.scanNil and getnilinstances then
            setProgress(0.40, "Layer 2: nil instances")
            pcall(function()
                local list = getnilinstances()
                if type(list) == "table" then
                    for _, obj in ipairs(list) do
                        if obj and (obj.ClassName == "RemoteEvent" or obj.ClassName == "RemoteFunction") then
                            addRemote(obj.Name, obj.ClassName, "(nil:" .. obj.Name .. ")", "nil", 3)
                        end
                    end
                end
            end)
            Run.RenderStepped:Wait()
        end

        if S.settings.scanWS then
            setProgress(0.50, "Layer 3: Workspace")
            pcall(function()
                for _, obj in ipairs(WS:GetDescendants()) do
                    if obj.ClassName == "RemoteEvent" or obj.ClassName == "RemoteFunction" then
                        addRemote(obj.Name, obj.ClassName, obj:GetFullName(), "Workspace", 1)
                    end
                end
            end)
            Run.RenderStepped:Wait()
        end

        if S.settings.scanPlayer then
            setProgress(0.58, "Layer 4: PlayerGui")
            pcall(function()
                for _, obj in ipairs(LP:GetDescendants()) do
                    if obj.ClassName == "RemoteEvent" or obj.ClassName == "RemoteFunction" then
                        addRemote(obj.Name, obj.ClassName, obj:GetFullName(), "PlayerGui", 1)
                    end
                end
            end)
            Run.RenderStepped:Wait()
        end

        if S.settings.scanModules and getloadedmodules then
            setProgress(0.66, "Layer 5: Modules")
            pcall(function()
                local mods = getloadedmodules()
                if type(mods) == "table" then
                    for _, m in ipairs(mods) do
                        pcall(function()
                            addScript(m.Name or "?", "Module", (m.GetFullName and m:GetFullName()) or "?")
                        end)
                    end
                end
            end)
            Run.RenderStepped:Wait()
        end

        if S.settings.scanReg and getreg then
            setProgress(0.74, "Layer 6: Registry")
            pcall(function()
                local reg = getreg()
                local count = 0
                for _, v in pairs(reg) do
                    if count > 300 then break end
                    count = count + 1
                    if type(v) == "userdata" then
                        pcall(function()
                            local mt = getmetatable(v)
                            if mt and mt.__name == "RemoteEvent" then
                                addRemote("reg_" .. count, "RemoteEvent", "(registry:" .. count .. ")", "getreg", 4)
                            end
                        end)
                    end
                end
            end)
        end
    end

    -- Hooks
    if not S.hooksInstalled then
        pcall(function()
            if hookmetamethod and getnamecallmethod and newcclosure then
                local old
                old = hookmetamethod(game, "__namecall", newcclosure(function(self, ...)
                    local m = getnamecallmethod()
                    if m == "FireServer" or m == "InvokeServer" then
                        if typeof(self) == "Instance" and (self.ClassName == "RemoteEvent" or self.ClassName == "RemoteFunction") then
                            local fullName = self:GetFullName()
                            table.insert(S.live, {
                                time = os.date("%H:%M:%S"),
                                name = fullName, method = m, args = {...},
                            })
                            if #S.live > 200 then table.remove(S.live, 1) end

                            if S.settings.watchAlerts then
                                for wname in pairs(S.watchlist) do
                                    if self.Name == wname or string.find(fullName, wname, 1, true) then
                                        notify("★ WATCH", wname .. " fired!", C.Pink)
                                    end
                                end
                            end
                        end
                    end
                    return old(self, ...)
                end))
                S.hooksInstalled = true
            end
        end)
    end

    table.sort(S.remotes, function(a, b) return a.score > b.score end)

    setProgress(1, "Done " .. string.format("%.2fs", clock() - t0))
    S.lastScan = clock()
    S.scanning = false
    setStatus("READY", C.Green)

    refreshStats()
    renderRemotes()
    updateAnalytics()

    local susCount = 0
    for _, r in ipairs(S.remotes) do if r.score >= 3 then susCount = susCount + 1 end end
    notify("Scan Done", string.format("%d remotes · %d مشبوه · %.2fs", #S.remotes, susCount, clock()-t0), C.Green)

    if S.settings.autoCopyOnScan then
        task.wait(0.5)
        copyMasterReport()
    end
end

