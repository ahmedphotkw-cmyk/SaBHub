local KW = {
    critical = {{"admin","panel","backdoor","exploit","bypass","godmode","instakill","onehit"},{"hack","cheat","inject","hook","spoof","fake","debug_mode"}},
    high     = {{"give","spawn","kick","ban","unban","warn","mute","jail","freeze","kill","killall","destroy","delete","wipe","purge"},{"setwalk","setspeed","setmoney","setlevel","setstat","admin_"}},
    medium   = {{"money","cash","coins","gem","diamond","reward","redeem","promo","vip","premium","boost","grant","gift","bonus","luck"},{"summon","create","generate","drop","item_"}},
    low      = {{"set","get","update","sync","force","trigger","dev","internal","secret","hidden","private","debug","test_","_test"}},
    network  = {{"fire","invoke","request","send","receive","push","pull","emit","remote","event","bind","dispatch"}},
}
local KW_W = {critical = 5, high = 3, medium = 2, low = 1, network = 0.5}

local function scoreName(name)
    local l = string.lower(name)
    local s, why = 0, {}
    for cat, groups in pairs(KW) do
        local w = KW_W[cat]
        for _, g in ipairs(groups) do
            for _, kw in ipairs(g) do
                if string.find(l, kw, 1, true) then
                    s = s + w
                    table.insert(why, kw)
                end
            end
        end
    end
    return s, why
end

local function levelOf(sc)
    if sc >= 8 then return "CRIT", C.Red end
    if sc >= 5 then return "HIGH", C.Orange end
    if sc >= 3 then return "MED", C.Yellow end
    if sc >= 1 then return "LOW", C.Dim end
    return "NONE", C.Muted
end

local function analyzeName(name)
    local f = {}
    if name:match("^%d+$") then table.insert(f, "numeric") end
    if name:match("%d%d%d%d%d%d%d%d") then table.insert(f, "long_num") end
    if name:match("^%u%l%u%l%u%l") then table.insert(f, "random_caps") end
    if #name > 40 then table.insert(f, "very_long") end
    if #name == 1 and name:match("%a") then table.insert(f, "single") end
    if name:find("_") and name:match("^%w+_%d+$") then table.insert(f, "numbered") end
    return f
end

local function entropy(s)
    if #s == 0 then return 0 end
    local counts = {}
    for i = 1, #s do local c = s:sub(i,i); counts[c] = (counts[c] or 0) + 1 end
    local e = 0
    for _, ct in pairs(counts) do
        local p = ct / #s
        e = e - p * math.log(p) / math.log(2)
    end
    return e / 8
end

