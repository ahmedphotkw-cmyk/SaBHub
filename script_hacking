-- EXECUTOR
-- ═══════════════════════════════════════════════════════════════════════
local function findRemoteByPath(path)
    local parts = {}
    for p in string.gmatch(path, "[^%.]+") do
        table.insert(parts, p)
    end
    local cur = game
    for _, p in ipairs(parts) do
        if not cur then return nil end
        cur = cur:FindFirstChild(p)
    end
    return cur
end

function executeRemote(noArgs)
    if not S.selectedRemote then
        notify("Execute", "اختر Remote أولاً من Remotes", C.Red)
        return
    end

    local remote = findRemoteByPath(S.selectedRemote.path)
    if not remote then
        notify("Execute", "لم يُوجد الـ Remote", C.Red)
        return
    end

    -- parse args
    local args = {}
    if not noArgs and argsBox.Text ~= "" then
        local txt = argsBox.Text
        -- try JSON first
        local okJson, parsed = pcall(function() return HttpS:JSONDecode(txt) end)
        if okJson and type(parsed) == "table" then
            args = parsed
        else
            -- pipe-separated
            for token in string.gmatch(txt, "([^|]+)") do
                token = token:gsub("^%s+", ""):gsub("%s+$", "")
                local num = tonumber(token)
                if num then
                    table.insert(args, num)
                elseif token == "true" then
                    table.insert(args, true)
                elseif token == "false" then
                    table.insert(args, false)
                elseif token == "nil" then
                    table.insert(args, nil)
                else
                    -- strip quotes
                    token = token:gsub('^"(.*)"$', "%1")
                    table.insert(args, token)
                end
            end
        end
    end

    local method = currentMethod
    local ok, result

    if method == "InvokeServer" then
        ok, result = pcall(function() return remote:InvokeServer(table.unpack(args)) end)
    else
        ok, result = pcall(function() remote:FireServer(table.unpack(args)) end)
        result = "(fired)"
    end

    table.insert(S.execHistory, 1, {
        time = os.date("%H:%M:%S"),
        name = S.selectedRemote.name,
        method = method,
        args = args,
        result = tostring(result),
        ok = ok,
    })
    if #S.execHistory > 30 then table.remove(S.execHistory) end

    renderHistory()
    notify(method, (ok and "✓ " or "✗ ") .. S.selectedRemote.name, ok and C.Green or C.Red)
end

