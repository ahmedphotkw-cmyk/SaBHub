-- ANALYTICS
-- ═══════════════════════════════════════════════════════════════════════
function updateAnalytics()
    local dist = {CRIT = 0, HIGH = 0, MED = 0, LOW = 0, NONE = 0}
    local kws, srcs = {}, {}
    for _, r in ipairs(S.remotes) do
        dist[levelOf(r.score)] = (dist[levelOf(r.score)] or 0) + 1
        for _, kw in ipairs(r.reasons or {}) do kws[kw] = (kws[kw] or 0) + 1 end
        srcs[r.source or "?"] = (srcs[r.source or "?"] or 0) + 1
    end
    local total = math.max(1, #S.remotes)
    local order = {"CRIT", "HIGH", "MED", "LOW", "NONE"}
    local cum = 0
    for i, key in ipairs(order) do
        local cnt = dist[key] or 0
        local pct = cnt / total
        chartSegs[i].Position = UDim2.new(cum, 0, 0, 0)
        chartSegs[i].Size = UDim2.new(pct, 0, 1, 0)
        cum = cum + pct
    end
    chartLbl.Text = string.format("CRIT:%d HIGH:%d MED:%d LOW:%d NONE:%d\nTotal:%d",
        dist.CRIT, dist.HIGH, dist.MED, dist.LOW, dist.NONE, #S.remotes)

    local kwArr = {}
    for k, v in pairs(kws) do table.insert(kwArr, {k=k, v=v}) end
    table.sort(kwArr, function(a, b) return a.v > b.v end)
    local kLines = {}
    for i, x in ipairs(kwArr) do
        if i > 10 then break end
        table.insert(kLines, string.format("%-12s %d", x.k, x.v))
    end
    kwLbl.Text = #kLines > 0 and table.concat(kLines, "\n") or "لا توجد keywords"

    local sArr = {}
    for k, v in pairs(srcs) do table.insert(sArr, {k=k, v=v}) end
    table.sort(sArr, function(a, b) return a.v > b.v end)
    local sLines = {}
    for i, x in ipairs(sArr) do
        if i > 8 then break end
        table.insert(sLines, string.format("%-14s %d", x.k, x.v))
    end
    srcLbl.Text = #sLines > 0 and table.concat(sLines, "\n") or "..."
end

